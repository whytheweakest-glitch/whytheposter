{
  "name": "whytheweakest-os",
  "version": "0.1.0",
  "private": true,
  "description": "WHYTHEWEAKEST OS: personal editorial system for a Telegram channel",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "prisma generate && next build",
    "start": "next start -p 3000",
    "bot": "tsx --env-file-if-exists=.env scripts/bot.ts",
    "worker": "tsx --env-file-if-exists=.env scripts/worker.ts",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "tsx --env-file-if-exists=.env prisma/seed.ts",
    "backup": "tsx --env-file-if-exists=.env scripts/backup.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "import:reference": "tsx --env-file-if-exists=.env scripts/import-reference.ts",
    "os": "tsx --env-file-if-exists=.env scripts/start-all.ts",
    "lint": "eslint . --max-warnings 0",
    "test:e2e": "tsx tests/e2e/prepare.ts && playwright test",
    "setup:check": "tsx --env-file-if-exists=.env scripts/setup-check.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "grammy": "^1.46.0",
    "next": "^15.5.29",
    "pino": "^9.6.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.5.29",
    "prisma": "^6.19.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.2.7"
  }
}
