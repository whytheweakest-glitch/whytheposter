# Скопируйте в .env и заполните. Файл .env не попадает в Git.
APP_ENV=development
APP_URL=http://localhost:3000
DATABASE_URL=file:./data.db?connection_limit=1&socket_timeout=15

# Случайная строка не короче 32 символов (например, результат `openssl rand -hex 32`)
SESSION_SECRET=

# Токен бота от @BotFather. Не пересылайте его в чаты.
TELEGRAM_BOT_TOKEN=
# Telegram ID владельца (и при необходимости администраторов), через запятую
OWNER_TELEGRAM_IDS=
# Куда публиковать: только тестовый канал, пока владелец не разрешил основной.
# ID канала вида -100xxxxxxxxxx
TEST_CHANNEL_ID=
MAIN_CHANNEL_ID=
# test | main. main работает, только если MAIN_CHANNEL_PUBLISH_CONFIRMED=true
PUBLISH_TARGET=test
MAIN_CHANNEL_PUBLISH_CONFIRMED=false

# AI: локальная модель через Ollama (https://ollama.com). disabled — система работает без AI.
AI_PROVIDER=ollama
OLLAMA_URL=http://127.0.0.1:11434
# Модель подбирается под видеокарту, например qwen2.5:7b-instruct
AI_MODEL=qwen2.5:7b-instruct
AI_TIMEOUT_MS=120000

STORAGE_DIR=./storage
BACKUP_DIR=./backups
LOG_LEVEL=info
